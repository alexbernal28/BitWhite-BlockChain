# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Seguridad y Autenticación
JWT_SECRET=super_secret_bitwhite_token_key
JWT_EXPIRES_IN=24h

# Configuración de Base de Datos (PostgreSQL)
POSTGRES_USER=bitwhite_user
POSTGRES_PASSWORD=bitwhite_password
POSTGRES_DB=bitwhite_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
